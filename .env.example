# ─────────────────────────────────────────────────────────────
# ArbiSim Guard — Canonical Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# All secrets go into this file; .env is gitignored.
# ─────────────────────────────────────────────────────────────

# ── ARBITRUM ──────────────────────────────────────────────────
ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_CHAIN_TESTNET_RPC=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID_ARBITRUM_ONE=42161
CHAIN_ID_ARBITRUM_SEPOLIA=421614

# ── AVALANCHE ─────────────────────────────────────────────────
AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Deployed SimulationRegistry contracts (from forge script output)
SIMULATION_REGISTRY_ADDRESS=0x9784f7cA750f1301a2090eaDF8f27F78B1A326b2
ARBITRUM_SEPOLIA_REGISTRY=0x5Dfd08c3d44BEBfa61a24Af8c2EfbDB5A01dFA32
AVALANCHE_FUJI_REGISTRY=0xb947B914fCb605D114E9f3C784a3fdE20B3f5CCc
AVALANCHE_MAINNET_REGISTRY=

# Deployed ERC-8004 reputation registries
ERC8004_REGISTRY_FUJI=0x8CA5F201A6Ec26C5F8807BA473220360E985767c
ERC8004_REGISTRY_MAINNET=

# ── INJECTIVE ─────────────────────────────────────────────────
# Injective EVM Testnet (Chain ID 1439) — real infrastructure, not mock
INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_MAINNET_RPC=https://sentry.evm-rpc.injective.network/

# SimulationRegistryV3 on Injective Testnet — set after running:
#   forge script script/DeployInjective.s.sol:DeployInjective \
#     --rpc-url $INJECTIVE_TESTNET_RPC --private-key $DEPLOYER_PRIVATE_KEY --broadcast
INJECTIVE_TESTNET_REGISTRY=
INJECTIVE_MAINNET_REGISTRY=

# Real ERC-8004 IdentityRegistry (CREATE2-deterministic across EVM chains)
# Source: Injective agent SDK repo / agents.injective.com/erc-8004
INJECTIVE_TESTNET_ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
INJECTIVE_TESTNET_ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
INJECTIVE_MAINNET_ERC8004_IDENTITY=
INJECTIVE_MAINNET_ERC8004_REPUTATION=

# Pyth oracle (pull model — stores contract address, not a Chainlink address)
# INJ/USD Pyth feed ID: 0x7a5bc1d2b56ad029048cd63964b3ad2776eadf812edc1a43a31406cb54bff592
INJECTIVE_TESTNET_PYTH_CONTRACT=0x36825bf3Fbdf5a29E2d5148bfe7Dcf7B5639e320
INJECTIVE_TESTNET_PYTH_FEED=0x7a5bc1d2b56ad029048cd63964b3ad2776eadf812edc1a43a31406cb54bff592
INJECTIVE_MAINNET_PYTH_CONTRACT=
INJECTIVE_MAINNET_PYTH_FEED=0x7a5bc1d2b56ad029048cd63964b3ad2776eadf812edc1a43a31406cb54bff592

# Frontend (Next.js public vars for trust page Injective chain support)
NEXT_PUBLIC_INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
NEXT_PUBLIC_INJECTIVE_MAINNET_RPC=https://sentry.evm-rpc.injective.network/
NEXT_PUBLIC_INJECTIVE_TESTNET_REGISTRY=
NEXT_PUBLIC_INJECTIVE_MAINNET_REGISTRY=


# ── ANVIL FORK ────────────────────────────────────────────────
ANVIL_PORT=8545
ANVIL_FORK_BLOCK_OFFSET=0
ANVIL_FORK_URL=https://arb1.arbitrum.io/rpc

# ── GATEWAY (Express) ─────────────────────────────────────────
PORT=3001
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
# Generate with: openssl rand -hex 16
GATEWAY_INTERNAL_SECRET=replace_with_32_char_random_string

# ── WORKER (Python) ───────────────────────────────────────────
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=500
WORKER_GATEWAY_URL=http://127.0.0.1:3001

# ── API KEY MANAGEMENT ────────────────────────────────────────
# Generate with: openssl rand -hex 16
ADMIN_API_KEY=replace_with_admin_key
API_KEY_HASH_SALT=replace_with_32_char_salt
JWT_SECRET=replace_with_jwt_secret

# ── DATA LAYER ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/arbisim
MONGODB_DB_NAME=arbisim
DATABASE_URL=postgresql://user:pass@host.neon.tech/arbisim?sslmode=require
NEONDB_URL=postgresql://user:pass@host.neon.tech/arbisim?sslmode=require
REDIS_URL=redis://localhost:6379

# ── LOCAL DOCKER ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arbisim_guard
MONGO_INITDB_DATABASE=arbisim_guard

# ── CLOUDFLARE WORKER (proxy) ─────────────────────────────────
# Set these as Cloudflare Worker secrets via wrangler, NOT in this file.
# CF_WORKER_GATEWAY_URL — the public URL of your deployed gateway server
# CF_WORKER_RATE_LIMIT_PER_MINUTE — default 60
# CF_KV_NAMESPACE_API_KEYS — KV namespace binding name

# ── ENTRYPOINTS (ERC-4337) ────────────────────────────────────
ENTRYPOINT_V06=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
ENTRYPOINT_V07=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ── ONCHAIN DEPLOY ────────────────────────────────────────────
# Foundry keystore is recommended over raw private key.
# Usage: forge script ... --account arbisim-deployer
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=use_foundry_keystore_not_raw_key
REGISTRY_SIGNER_KEY=use_foundry_keystore_not_raw_key
# Legacy alias (chain_registry.py fallback)
ARB_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── BLOCK EXPLORER API KEYS ───────────────────────────────────
SNOWTRACE_API_KEY=                   # https://snowscan.xyz/myapikey
# ARBISCAN_API_KEY is read by foundry.toml via ${ARBISCAN_API_KEY}
ARBISCAN_API_KEY=

# ── POSTHOG ───────────────────────────────────────────────────
POSTHOG_API_KEY=

# ── FRONTEND (Next.js — NEXT_PUBLIC_ vars are bundled into client JS) ──
NEXT_PUBLIC_API_BASE_URL=https://api.arbisim.pages.dev
NEXT_PUBLIC_CF_WORKER_URL=https://arbisim-proxy.YOUR_SUBDOMAIN.workers.dev
NEXT_PUBLIC_SITE_URL=https://arbisimguard.vercel.app
NEXT_PUBLIC_ARBITRUM_CHAIN_ID=42161
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_ONMETA_API_KEY=
NEXT_PUBLIC_APP_URL=https://arbisimguard.vercel.app

# ── BILLING ───────────────────────────────────────────────────
MERCHANT_ADDRESS=
SIMULATION_REGISTRY_CHAIN_ID=42161
SIMULATION_REGISTRY_SEPOLIA=0x5Dfd08c3d44BEBfa61a24Af8c2EfbDB5A01dFA32
